# deer-flow/backend/.env — the file the stack actually reads.
#
# Copy to `.env` and fill in. NOTHING here has a usable default; the analyst
# fails in confusing, partial ways when a key is missing (a bad SLACK_USER_TOKEN
# looks like "search returns nothing", a missing GOOGLE_REFRESH_TOKEN looks like
# "Drive is empty"), so fill the whole file before first start.
#
# Keep `deer-flow/.env` and `deer-flow/backend/.env` IN SYNC — the Google values
# in particular are read from both depending on the entry point.
#
# Generated from the live box 2026-08-10. If you add a key to .env, add it here
# too — this file being 15 keys short of reality is exactly what made the last
# rebuild guesswork.

# --- Anthropic -------------------------------------------------------------
# console.anthropic.com -> API keys. Drives every agent, cron and classifier.
ANTHROPIC_API_KEY=

# --- Slack -----------------------------------------------------------------
# api.slack.com/apps -> your app. The bot runs in Socket Mode, so you need BOTH
# the bot token and an app-level token.
#   BOT   xoxb- : OAuth & Permissions -> Bot User OAuth Token
#   APP   xapp- : Basic Information -> App-Level Tokens (scope connections:write)
#   USER  xoxp- : OAuth & Permissions -> User OAuth Token. Needed by the
#                 slack-search skill; scopes search:read, users:read,
#                 users:read.email
#   SIGNING     : Basic Information -> Signing Secret
#   OWNER       : Brian's Slack member ID (U05B5HGNCN9) — who gets DMs. NOT the
#                 bot's own ID; confusing the two makes the analyst report its
#                 own DMs as Brian's mail.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_USER_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_OWNER_USER_ID=
# Channel for the approve-first proposal queue. Leave EMPTY to keep proposals
# as owner DMs — setting it activates the queue.
ANALYST_QUEUE_CHANNEL_ID=

# --- Redshift --------------------------------------------------------------
# Only reachable through the Zscaler ZPA tunnel. Connections MUST use
# sslmode=require + sslrootcert=disable (cert verification fails otherwise).
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DB=
REDSHIFT_USER=
REDSHIFT_PASSWORD=

# --- Google (Drive / Gmail / Calendar) -------------------------------------
# Run `python scripts/setup_google_auth.py` to mint the refresh token. Scopes:
# drive (full), gmail.compose, gmail.readonly, calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Gmail webhook (Pub/Sub -> ngrok -> webhook_receiver) ------------------
# GCP project brian-sandbox-458317. The push subscription must be created with
# --expiration-period=never; a 31-day idle expiry silently killed proposals for
# 33 days once. NGROK_PUBLIC_DOMAIN is the RESERVED domain (a random ngrok URL
# breaks the Pub/Sub push endpoint on every restart).
NGROK_PUBLIC_DOMAIN=
PUBSUB_VERIFICATION_TOKEN=
WEBHOOK_PORT=8080

# --- Okta / Zscaler reauth -------------------------------------------------
# NOT here. OKTA_USERNAME / OKTA_PASSWORD live in the REPO-ROOT .env — that is
# the file scripts/zscaler_reauth.py loads them from. See ../../.env.example.

# --- Internal service URLs -------------------------------------------------
LANGGRAPH_URL=http://localhost:2024
HONCHO_BASE_URL=http://localhost:8000
HONCHO_APP_NAME=deerflow

# --- Third-party tools -----------------------------------------------------
LINEAR_API_KEY=
METABASE_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=
